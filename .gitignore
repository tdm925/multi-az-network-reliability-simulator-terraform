# Terraform: downloaded providers and local working data
.terraform/

# Terraform: state holds everything about the deployed resources,
# sometimes including secrets. Never commit it.
*.tfstate
*.tfstate.*

# Terraform: crash logs
crash.log
crash.*.log

# Terraform: variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform: local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform: CLI config files
.terraformrc
terraform.rc

# Note: .terraform.lock.hcl is NOT ignored on purpose.
# It pins the provider version and should be committed.
